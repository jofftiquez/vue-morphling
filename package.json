{
  "name": "vue-morphling",
  "version": "1.2.1",
  "description": "Filters and directives for Vue 2 and Vue 3.",
  "main": "dist/vue-morphling.cjs",
  "module": "dist/vue-morphling.mjs",
  "unpkg": "dist/vue-morphling.js",
  "jsdelivr": "dist/vue-morphling.js",
  "types": "types/vue-morphling.d.ts",
  "exports": {
    ".": {
      "types": "./types/vue-morphling.d.ts",
      "import": "./dist/vue-morphling.mjs",
      "require": "./dist/vue-morphling.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "types"
  ],
  "sideEffects": false,
  "semistandard": {
    "ignore": [
      "dist"
    ],
    "env": [
      "jest",
      "browser"
    ]
  },
  "scripts": {
    "test": "jest",
    "lint": "semistandard --fix | snazzy",
    "prebuild": "rimraf dist && yarn lint && yarn test && yarn test:types",
    "build": "rollup -c",
    "test:types": "tsc -p test/types"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "filesize": "^11.0.26"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-commonjs": "^29",
    "@rollup/plugin-node-resolve": "^16",
    "@rollup/plugin-terser": "^1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rimraf": "^6",
    "rollup": "^4",
    "semistandard": "^17.0.0",
    "snazzy": "^9.0.0",
    "typescript": "^6.0.3",
    "vue": "^3.5.0",
    "vue2": "npm:vue@^2.7.16",
    "vue26": "npm:vue@2.6.14"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jofftiquez/vue-morphling.git"
  },
  "keywords": [
    "filters",
    "directives",
    "vue",
    "vue2",
    "vue3",
    "vuejs",
    "nuxt"
  ],
  "author": "Jofferson R Tiquez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jofftiquez/vue-morphling/issues"
  },
  "homepage": "https://github.com/jofftiquez/vue-morphling#readme"
}

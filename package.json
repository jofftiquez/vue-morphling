{
  "name": "vue-morphling",
  "version": "1.2.1",
  "description": "A collection of VueJs filters.",
  "main": "dist/vue-morphling.cjs",
  "module": "dist/vue-morphling.mjs",
  "unpkg": "dist/vue-morphling.js",
  "jsdelivr": "dist/vue-morphling.js",
  "exports": {
    ".": {
      "import": "./dist/vue-morphling.mjs",
      "require": "./dist/vue-morphling.cjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "semistandard": {
    "ignore": [
      "dist"
    ],
    "env": [
      "jest",
      "browser"
    ]
  },
  "scripts": {
    "test": "jest",
    "lint": "semistandard --fix | snazzy",
    "prebuild": "rimraf dist && yarn lint && yarn test",
    "build": "rollup -c"
  },
  "dependencies": {
    "date-fns": "^2.30.0",
    "filesize": "^6.1.0",
    "utf8-length": "^0.0.1"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@rollup/plugin-commonjs": "^29",
    "@rollup/plugin-node-resolve": "^16",
    "@rollup/plugin-terser": "^1",
    "babel-jest": "^30.5.2",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "rimraf": "^6",
    "rollup": "^4",
    "semistandard": "^17.0.0",
    "snazzy": "^9.0.0",
    "vue": "^3.5.0",
    "vue2": "npm:vue@^2.7.16"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:jofftiquez/vue-morphling.git"
  },
  "keywords": [
    "filters",
    "vue",
    "vuejs"
  ],
  "author": "Jofferson R Tiquez",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/jofftiquez/vue-morphling/issues"
  },
  "homepage": "https://github.com/jofftiquez/vue-morphling#readme",
  "peerDependencies": {}
}
